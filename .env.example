# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=        # Google AI Studio key: text (Gemini) and, with billing enabled, image editing
GROQ_API_KEY=          # optional fallback LLM (Groq, openai/gpt-oss-120b)
SERPAPI_API_KEY=       # Google Shopping search for competitor analysis

# Optional overrides
# TEXT_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash
# FALLBACK_TEXT_MODEL=openai/gpt-oss-120b
# IMAGE_MODEL=gemini-2.5-flash-image
